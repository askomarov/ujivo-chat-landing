---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MainHead from '../components/MainHead.astro';
import { WIDGET_SITE_ID, WIDGET_SITE_KEY, WIDGET_SRC } from '../config';
import { HTML_LANG, useTranslations, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	title?: string;
	description?: string;
	/** Путь без префикса локали, нужен для canonical и hreflang. */
	path?: string;
}

const { lang, title, description, path = '' } = Astro.props;
const t = useTranslations(lang);
---

<html lang={HTML_LANG[lang]}>
	<head>
		<MainHead
			{lang}
			{path}
			title={title ?? t.meta.title}
			description={description ?? t.meta.description}
		/>
	</head>
	<body class="page">
		<a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
		<Header {lang} {path} />
		<main id="main">
			<slot />
		</main>
		<Footer {lang} />

		<script>
			import '../scripts/reveal';
		</script>
		<script
			is:inline
			src={WIDGET_SRC}
			data-site-id={WIDGET_SITE_ID}
			data-site-key={WIDGET_SITE_KEY}
		></script>
	</body>
</html>
