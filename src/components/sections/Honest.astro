---
import type { Dictionary } from '../../i18n';
import Icon from '../Icon.astro';

interface Props {
	honest: Dictionary['honest'];
}

const { honest } = Astro.props;
---

<section class="section honest-section">
	<div class="honest-card reveal">
		<div class="honest-icon">
			<Icon icon="alertCircle" size="20px" />
		</div>
		<h3>{honest.title}</h3>
		<p>{honest.text}</p>
	</div>
</section>

<style>
	.honest-section {
		padding: 3rem 2rem;
	}

	.honest-card {
		max-width: 680px;
		margin: 0 auto;
		background: var(--surface-2);
		border: 1px dashed var(--border-hover);
		border-radius: var(--radius);
		padding: 2rem;
		text-align: center;
		transition:
			background-color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.honest-icon {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--surface);
		border: 1px solid var(--border);
		color: var(--text-mute);
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1rem;
	}

	.honest-card h3 {
		font-size: 1.05rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
		color: var(--text);
	}

	.honest-card p {
		color: var(--text-dim);
		font-size: 0.92rem;
	}

	@media (max-width: 56.24em) {
		.honest-section {
			padding: 2rem 1.2rem;
		}
	}
</style>
