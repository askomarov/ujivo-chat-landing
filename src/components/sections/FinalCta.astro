---
import { LOGIN_URL } from '../../config';
import type { Dictionary } from '../../i18n';

interface Props {
	cta: Dictionary['cta'];
}

const { cta } = Astro.props;
---

<section class="section cta-section" id="cta">
	<div class="cta-card reveal">
		<h2 class="cta-title">
			{cta.titleLine}<br />
			<span class="accent-text">{cta.titleAccent}</span>
		</h2>
		<p class="cta-sub">{cta.subtitle}</p>
		<a href={LOGIN_URL} class="btn btn-primary btn-lg">{cta.button}</a>
		<p class="cta-note">{cta.note}</p>
	</div>
</section>

<style>
	.cta-section {
		padding: 5rem 2rem;
	}

	.cta-card {
		max-width: 640px;
		margin: 0 auto;
		text-align: center;
		background: var(--bg-dark);
		border-radius: 24px;
		padding: 3.5rem 2.5rem;
		transition: background-color var(--theme-transition);
	}

	.cta-title {
		font-size: clamp(1.7rem, 4vw, 2.4rem);
		font-weight: 600;
		margin-bottom: 1rem;
		color: #fff;
		line-height: 1.15;
	}

	/* На тёмной плашке индиго не читается, поэтому акцент светлее. */
	.cta-title :global(.accent-text) {
		color: var(--accent-on-dark);
	}

	.cta-sub {
		color: rgba(255, 255, 255, 0.72);
		font-size: 1.05rem;
		margin-bottom: 2rem;
	}

	.cta-note {
		color: rgba(255, 255, 255, 0.5);
		font-size: 0.85rem;
		margin-top: 1rem;
	}

	@media (max-width: 56.24em) {
		.cta-section {
			padding: 3.5rem 1.2rem;
		}

		.cta-card {
			padding: 2.5rem 1.5rem;
		}
	}
</style>
