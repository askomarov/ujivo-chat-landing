---
import type { Dictionary } from '../../i18n';

interface Props {
	cta: Dictionary['cta'];
}

const { cta } = Astro.props;
---

<section class="section cta-section" id="cta">
	<div class="cta-card reveal">
		<h2 class="cta-title">
			{cta.titleLine}<br />
			<span class="accent-text">{cta.titleAccent}</span>
		</h2>
		<p class="cta-sub">{cta.subtitle}</p>
		<button type="button" class="btn btn-primary btn-lg" id="cta-contact-btn">{cta.button}</button>
		<p class="cta-note">{cta.note}</p>
	</div>
</section>

<script>
	document.getElementById('cta-contact-btn')?.addEventListener('click', () => {
		console.log('hello');
	});
</script>

<style>
	.cta-section {
		padding: 5rem 2rem;
	}

	.cta-card {
		position: relative;
		overflow: hidden;
		max-width: 640px;
		margin: 0 auto;
		text-align: center;
		background:
			radial-gradient(circle at 82% 12%, var(--cherry-glow-strong), transparent 19rem),
			radial-gradient(circle at 8% 100%, var(--cherry-glow), transparent 17rem),
			var(--bg-dark);
		border: 1px solid color-mix(in srgb, var(--primary-light) 24%, transparent);
		border-radius: 24px;
		padding: 3.5rem 2.5rem;
		box-shadow: var(--shadow-lg);
		transition:
			background var(--theme-transition),
			border-color var(--theme-transition);
	}

	.cta-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--noise-layer);
		mix-blend-mode: soft-light;
		opacity: calc(var(--grain-opacity) * 1.5);
		pointer-events: none;
		-webkit-mask-image: radial-gradient(ellipse at center, #000 20%, transparent 90%);
		mask-image: radial-gradient(ellipse at center, #000 20%, transparent 90%);
	}

	.cta-card > * {
		position: relative;
		z-index: 1;
	}

	.cta-title {
		font-size: clamp(1.7rem, 4vw, 2.4rem);
		font-weight: 600;
		margin-bottom: 1rem;
		color: #fff;
		line-height: 1.15;
	}

	/* На тёмной плашке индиго не читается, поэтому акцент светлее. */
	.cta-title :global(.accent-text) {
		color: var(--accent-on-dark);
	}

	.cta-sub {
		color: rgba(255, 255, 255, 0.72);
		font-size: 1.05rem;
		margin-bottom: 2rem;
	}

	.cta-note {
		color: rgba(255, 255, 255, 0.5);
		font-size: 0.85rem;
		margin-top: 1rem;
	}

	@media (max-width: 56.24em) {
		.cta-section {
			padding: 3.5rem 1.2rem;
		}

		.cta-card {
			padding: 2.5rem 1.5rem;
		}
	}
</style>
